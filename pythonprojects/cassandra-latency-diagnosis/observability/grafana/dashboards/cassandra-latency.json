{
  "uid": "cass-latency",
  "title": "Cassandra Read Latency — Tombstone Incident",
  "schemaVersion": 39,
  "timezone": "utc",
  "refresh": "",
  "time": { "from": "now-6m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Read latency (ms) — p99 / p50",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cassandra_clientrequest_latency_p99{operation=\"Read\"} / 1000",
          "legendFormat": "p99"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cassandra_clientrequest_latency_p50{operation=\"Read\"} / 1000",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tombstones scanned per read (p99) — demo.events",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cassandra_table_tombstones_scanned_p99{keyspace=\"demo\", table=\"events\"}",
          "legendFormat": "tombstones / read"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SSTables & pending compactions — demo.events",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cassandra_table_live_sstable_count{keyspace=\"demo\", table=\"events\"}",
          "legendFormat": "live SSTables"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cassandra_compaction_pending_tasks",
          "legendFormat": "pending compactions"
        }
      ]
    }
  ]
}
