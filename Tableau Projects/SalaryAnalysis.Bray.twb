    <worksheet name='Top 5 States Ranked by the Adjusted Median Paid Wage'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='12'>Top 5 States Ranked by the Adjusted Median Paid Wage</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (salary_data_states_corrected)' name='federated.0kqc5ep0qostbg14zt2kr0j6jqcn' />
            <datasource name='Parameters' />
