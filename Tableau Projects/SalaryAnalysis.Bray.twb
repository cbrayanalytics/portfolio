    <dashboard name='Final Story' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='14'>Salary Analysis of Data-Related Jobs from 2008-2015</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='12'>(Green Card and H1B Visa holders)</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-description'>
          <format attr='background-color' id='story-description_6' value='#00000000' />
          <format attr='border-width' id='story-description_6' value='0' />
          <format attr='border-style' id='story-description_6' value='none' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98214' id='1' param='vert' removable='false' type-v2='layout-flow' w='99030' x='485' y='893'>
            <zone h='5469' id='3' type-v2='title' w='99030' x='485' y='893' />
            <zone h='11272' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99030' x='485' y='6362' />
            <zone h='81473' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99030' x='485' y='17634'>
              <flipboard active-id='7' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Introduction' captured-sheet='' id='1' />
                  <story-point caption='Total number of jobs and median paid wage per year' captured-sheet='Data Related Jobs Dashboard' id='2' />
                  <story-point caption='Median paid wage per year by job and visa class' captured-sheet='Visa Class Dashboard' id='3'>
                    <capturedDeltas>
                      <worksheet name='Median Paid Wage by Visa Class (Box)'>
                        <selection-collection />
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='Difference between paid and prevailing wage' captured-sheet='Median vs Prevailing Dashboard' id='4' />
                  <story-point caption='Paid wage vs. wage adjusted for cost of living in each state' captured-sheet='Paid Wage vs Adjusted Wage Dashboard' id='5'>
                    <capturedDeltas>
                      <worksheet name='Paid Wage vs Adjusted Paid Wage* in 5 Selected States'>
                        <highlight>
                          <color-one-way>
                            <field>[federated.0kqc5ep0qostbg14zt2kr0j6jqcn].[:Measure Names]</field>
                          </color-one-way>
                        </highlight>
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='States with the highest adjusted paid wage' captured-sheet='Top 5 States Dashboard' id='6' />
                  <story-point caption='Companies with the highest adjusted paid wage' captured-sheet='Top 5 Median Paid Wage Dashboard' id='7' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='39063' hidden='true' id='6' story-point-id='1' type-v2='text' w='42005' x='29117' y='22545'>
          <formatted-text>
            <run fontsize='12'>This project aims to investigate the salary trend of four data-related jobs: </run>
            <run bold='true' fontsize='12'>business analyst, data analyst, data scientist, </run>
            <run fontsize='12'>and </run>
            <run bold='true' fontsize='12'>software engineer.</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='12'>Samples included in the analysis are </run>
            <run bold='true' fontsize='12'>Green Card Holders </run>
            <run fontsize='12'>and </run>
            <run bold='true' fontsize='12'>H1B Visa Holders.</run>
            <run>Æ&#10;&#10;</run>
            <run fontsize='12'>Originated from the 2008-15 Office of Foreign Labor Certification website, the dataset is provided by Duke University through Coursera.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{F7A7BDD7-FE41-470F-B782-10B3E0F6C4EA}' />
    </dashboard>
