      <column caption='Difference Between Median Paid Wage and Prevailing Wage' datatype='real' name='[Calculation_1895452544441417730]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[PAID_WAGE_PER_YEAR]-[PREVAILING_WAGE_PER_YEAR]' />
      </column>
      <column caption='Paying Less Than Prevailing Wage' datatype='string' name='[Calculation_1895452544443498499]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1895452544441417730] &lt;0&#13;&#10;THEN &apos;Paid Less Than Prevailing Wage&apos;&#13;&#10;ELSE &apos;Paid Prevailing Wage or Higher&apos;&#13;&#10;END' />
      </column>
      <column caption='Adjusted Paid Wage' datatype='real' name='[Calculation_1895452544478519301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(MEDIAN([PAID_WAGE_PER_YEAR])/ATTR([federated.0ewcpus1t1gw3z12cucbo11e83zy].[Price Parity]))*100' />
      </column>
      <column caption='States We Are Intereseted In' datatype='string' name='[Calculation_1895452544483254278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [WORK_STATE] = &apos;Georgia&apos;&#13;&#10;THEN &apos;View&apos;&#13;&#10;ELSEIF [WORK_STATE] = &apos;North Carolina&apos;&#13;&#10;THEN &apos;View&apos;&#13;&#10;ELSEIF [WORK_STATE] = &apos;New York&apos;&#13;&#10;THEN &apos;View&apos;&#13;&#10;ELSEIF [WORK_STATE] = &apos;Washington&apos;&#13;&#10;THEN &apos;View&apos;&#13;&#10;ELSEIF [WORK_STATE] = &apos;California&apos;&#13;&#10;THEN &apos;View&apos;&#13;&#10;ELSE &apos;Not View&apos;&#13;&#10;END' />
      </column>
      <column caption='Data Jobs' datatype='string' name='[Calculation_1895452544487579655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [JOB_TITLE_SUBGROUP] = &apos;business analyst&apos;&#13;&#10;THEN &apos;Data Job&apos;&#13;&#10;ELSEIF [JOB_TITLE_SUBGROUP] = &apos;data analyst&apos;&#13;&#10;THEN &apos;Data Job&apos;&#13;&#10;ELSEIF [JOB_TITLE_SUBGROUP] = &apos;data scientist&apos;&#13;&#10;THEN &apos;Data Job&apos;&#13;&#10;ELSEIF [JOB_TITLE_SUBGROUP] = &apos;software engineer&apos;&#13;&#10;THEN &apos;Data Job&apos;&#13;&#10;ELSE &apos;Not Data Job&apos;&#13;&#10;END' />
